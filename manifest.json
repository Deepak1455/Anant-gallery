{
  "id": "/",
  "name": "Anant Gallery - Infinite Cloud Storage",
  "short_name": "Anant Gallery",
  "description": "Secure Infinite Photo Cloud & Private Vault Storage",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#090d16",
  "theme_color": "#000000",
  "categories": [
    "photos",
    "productivity",
    "utilities"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "scope_extensions": [
    { "origin": "https://anant-gallery.vercel.app" },
    { "origin": "https://my-photo-d96e9.firebaseapp.com" },
    { "origin": "https://anant-cdn.dt8484970.workers.dev" }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Albums & Folders",
      "short_name": "Albums",
      "description": "View albums and collections",
      "url": "/?view=albums",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Favorites",
      "short_name": "Favorites",
      "description": "View favorite photos",
      "url": "/?view=favorites",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Private Vault",
      "short_name": "Vault",
      "description": "Secure private locked photos",
      "url": "/?view=hidden",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+gallery",
      "url": "/?url=%s"
    }
  ],
  "screenshots": [
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Anant Gallery Mobile View"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Anant Gallery Tablet View"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=app.vercel.anant_gallery.twa",
      "id": "app.vercel.anant_gallery.twa"
    }
  ],
  "prefer_related_applications": false
}
