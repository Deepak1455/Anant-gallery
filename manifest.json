{
  "id": "/",
  "name": "Anant Gallery - Infinite Cloud Storage",
  "short_name": "Anant Gallery",
  "description": "Secure Infinite Photo Cloud & Private Vault Storage",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#090d16",
  "theme_color": "#000000",
  "categories": [
    "photos",
    "productivity",
    "utilities"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Albums & Folders",
      "short_name": "Albums",
      "description": "View albums and collections",
      "url": "/?view=albums",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any maskable"
        }
      ]
    },
    {
      "name": "Favorites",
      "short_name": "Favorites",
      "description": "View favorite photos",
      "url": "/?view=favorites",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any maskable"
        }
      ]
    },
    {
      "name": "Private Vault",
      "short_name": "Vault",
      "description": "Secure private locked photos",
      "url": "/?view=hidden",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any maskable"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".gif",
            ".heic"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/*": [
          ".jpg",
          ".jpeg",
          ".png",
          ".webp",
          ".gif",
          ".heic"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+gallery",
      "url": "/?url=%s"
    }
  ],
  "screenshots": [
    {
      "src": "/icon-512.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Anant Gallery Mobile Cloud"
    },
    {
      "src": "/icon-512.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Anant Gallery Desktop View"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=app.vercel.anantgallery.twa",
      "id": "app.vercel.anantgallery.twa"
    }
  ],
  "prefer_related_applications": false
}
